# .env.example — copy to .env, then edit the REQUIRED section below:
#   cp .env.example .env
#
# Summary of what you must change:
#   - FalkorDB section : nothing, if you use the bundled docker-compose.yml.
#   - LLM section      : REQUIRED. Point it at your own endpoint and models.

# =============================================================================
# FalkorDB — works out of the box with `docker compose up -d`. No edits needed.
# =============================================================================

# Matches REDIS_ARGS=--requirepass in docker-compose.yml. Change both together.
FALKORDB_PASSWORD=falkordb

# Connection string for the graph store, in redis://:password@host:port/db form.
# Leave it as localhost to use the bundled container, or point it at an existing
# FalkorDB anywhere on your network (then you do not need docker at all).
NEO4J_URI=redis://:falkordb@localhost:6379/0
NEO4J_USERNAME=
NEO4J_PASSWORD=falkordb

# Graph key/name used by the FalkorDB wrapper.
GRAPH_NAME=memory

# =============================================================================
# LLM — REQUIRED. The defaults below are placeholders and will not work as-is.
# =============================================================================
#
# Any OpenAI-compatible endpoint works (LM Studio, vLLM, Ollama, ...).
#
# MODEL_NAME must match an id the endpoint actually serves, exactly. Check with:
#   curl http://<your-host>:<port>/v1/models

## KG LLM — used for ingest (summarise, extract entities) and retrieval.
LLM_API="http://localhost:1234/v1"
MODEL_NAME="openai/gpt-oss-20b"

## Judge LLM — grades answers during evaluation. Kept separate from the KG LLM
## so grading stays independent of the model under test; it may be the same
## endpoint, or a different one.
JUDGE_LLM_API="http://localhost:1234/v1"
JUDGE_MODEL_NAME="openai/gpt-oss-20b"

## To use the OpenAI API instead, uncomment these and supply your own key.
#LLM_API="https://api.openai.com/v1"
#MODEL_NAME="gpt-4o-mini"
#OPENAI_API_KEY=""

# =============================================================================
# Agent filter — the post-retrieval evidence-refinement agent (GREP/READ/VECTOR).
# =============================================================================

## Model that drives the filter agent. Defaults to the KG LLM above if unset;
## set these to run the agent on a different endpoint/model than ingest.
GREP_AGENT_LLM_API="http://localhost:1234/v1"
GREP_AGENT_MODEL_NAME="openai/gpt-oss-20b"

## LongMem VECTOR tool — root dir holding each question's summary VDB
## (summaries_chroma). Leave empty to disable the VECTOR tool.
## Overridable per-run with `replay_run.py --artifact-root`.
LONGMEM_ARTIFACT_ROOT=""

## Optional: LoCoMo `--ledger` fact-table compiler. Defaults to the KG LLM
## above; set these only to run the compile step on a stronger endpoint/model.
#LEDGER_COMPILER_API="http://localhost:1234/v1"
#LEDGER_COMPILER_MODEL="openai/gpt-oss-120b"
