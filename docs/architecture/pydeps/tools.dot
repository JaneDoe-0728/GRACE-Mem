
digraph G {
    graph [label="tools · internal modules",labelloc="t",fontsize=20,fontname="Helvetica",pad=0.3,nodesep=0.45,ranksep=0.8,bgcolor="#fbfbfc"];
    edge [color="#6b7280",arrowsize=0.75,penwidth=1.1];
    concentrate = true;

    rankdir = LR;
    node [style=filled,fillcolor="#ffffff",fontcolor="#000000",fontname=Helvetica,fontsize=10];

    tools_annotate_evidence [fillcolor="#b65353",fontcolor="#ffffff",label="annotate_evidence"];
    tools_build_dep_graph [fillcolor="#995252",fontcolor="#ffffff",label="build_dep_graph"];
    tools_gen_dep_graph [fillcolor="#b65353",fontcolor="#ffffff",label="gen_dep_graph"];
    tools_build_dep_graph -> tools_annotate_evidence [fillcolor="#995252"];
    tools_build_dep_graph -> tools_gen_dep_graph [fillcolor="#995252"];
}
