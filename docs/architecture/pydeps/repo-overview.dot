
digraph G {
    graph [label="GRACE-Mem · package overview",labelloc="t",fontsize=20,fontname="Helvetica",pad=0.3,nodesep=0.45,ranksep=0.8,bgcolor="#fbfbfc"];
    edge [color="#6b7280",arrowsize=0.75,penwidth=1.1];
    concentrate = true;

    rankdir = LR;
    node [style=filled,fillcolor="#ffffff",fontcolor="#000000",fontname=Helvetica,fontsize=10];

    experiment [fillcolor="blue",fontcolor="white",shape="box"];
    grace_mem [fillcolor="#33cc33"];
    tools [fillcolor="blue",fontcolor="white",shape="box"];
    tools -> experiment [fillcolor="blue"];
    experiment -> grace_mem [fillcolor="blue"];
    tools -> grace_mem [fillcolor="blue"];
    experiment -> tools [fillcolor="blue"];
}
